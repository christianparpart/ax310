{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "PEDANTIC_COMPILER": "ON"
            }
        },

        {
            "name": "clang-debug",
            "displayName": "Clang Debug (PEDANTIC + ASan + UBSan + clang-tidy)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "PEDANTIC_COMPILER_WERROR": "ON",
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "ENABLE_SANITIZER_UNDEFINED": "ON",
                "ENABLE_TIDY": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "clang-release",
            "displayName": "Clang Release (PEDANTIC, -O3)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "gcc-debug",
            "displayName": "GCC Debug (PEDANTIC)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "gcc-release",
            "displayName": "GCC Release (PEDANTIC, -O3)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "clang-coverage",
            "displayName": "Clang Coverage (llvm-cov source-based; needs llvm-profdata/llvm-cov)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_COVERAGE": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "clang-asan-ubsan",
            "displayName": "Clang ASan + UBSan (no clang-tidy)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "ENABLE_SANITIZER_UNDEFINED": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "clang-tsan",
            "displayName": "Clang ThreadSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_SANITIZER_THREAD": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "cl-debug",
            "displayName": "MSVC Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "cl-release",
            "displayName": "MSVC Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "clangcl-debug",
            "displayName": "clang-cl Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "clangcl-release",
            "displayName": "clang-cl Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "PEDANTIC_COMPILER_WERROR": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "cross-windows-base",
            "hidden": true,
            "inherits": "base",
            "description": "Cross-compile to Windows x64 from Linux or macOS, against the MSVC toolchain and Windows SDK that msvc-wine downloads from Microsoft. Needs MSVC_CROSS_ROOT pointing at a checkout of https://github.com/christianparpart/msvc-cross for the toolchain files, and QT_ROOT_DIR pointing at a Windows Qt kit -- the same variable install-qt-action sets in CI. Conditioned off on Windows, where the cl-* and clangcl-* presets above apply.",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "CMAKE_CATCH_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
            }
        },
        {
            "name": "cross-cl-release",
            "displayName": "MSVC Release (cross-compiled, cl.exe under Wine)",
            "description": "Microsoft's own cl.exe and link.exe, driven under Wine. The real compiler, so this is what to trust when the question is what MSVC does. Qt's moc.exe and rcc.exe are Windows binaries too and run the same way.",
            "inherits": "cross-windows-base",
            "toolchainFile": "$env{MSVC_CROSS_ROOT}/toolchains/msvc-wine-x64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "cross-clangcl-release",
            "displayName": "clang-cl Release (cross-compiled, native)",
            "description": "clang-cl and lld-link running natively on the host against the same MSVC headers and import libraries, with Wine out of the compile path. Faster than cross-cl-release; prefer it for iteration.",
            "inherits": "cross-windows-base",
            "toolchainFile": "$env{MSVC_CROSS_ROOT}/toolchains/clang-cl-x64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "clang-debug",      "configurePreset": "clang-debug" },
        { "name": "clang-release",    "configurePreset": "clang-release" },
        { "name": "gcc-debug",        "configurePreset": "gcc-debug" },
        { "name": "gcc-release",      "configurePreset": "gcc-release" },
        { "name": "clang-coverage",   "configurePreset": "clang-coverage" },
        { "name": "clang-asan-ubsan", "configurePreset": "clang-asan-ubsan" },
        { "name": "clang-tsan",       "configurePreset": "clang-tsan" },
        { "name": "cl-debug",         "configurePreset": "cl-debug" },
        { "name": "cl-release",       "configurePreset": "cl-release" },
        { "name": "clangcl-debug",    "configurePreset": "clangcl-debug" },
        { "name": "clangcl-release",  "configurePreset": "clangcl-release" },

        { "name": "cross-cl-release",      "configurePreset": "cross-cl-release" },
        { "name": "cross-clangcl-release", "configurePreset": "cross-clangcl-release" }
    ],
    "testPresets": [
        { "name": "clang-debug",      "configurePreset": "clang-debug",      "output": { "outputOnFailure": true } },
        { "name": "clang-release",    "configurePreset": "clang-release",    "output": { "outputOnFailure": true } },
        { "name": "gcc-debug",        "configurePreset": "gcc-debug",        "output": { "outputOnFailure": true } },
        { "name": "gcc-release",      "configurePreset": "gcc-release",      "output": { "outputOnFailure": true } },
        { "name": "clang-coverage",   "configurePreset": "clang-coverage",   "output": { "outputOnFailure": true } },
        { "name": "clang-asan-ubsan", "configurePreset": "clang-asan-ubsan", "output": { "outputOnFailure": true } },
        { "name": "clang-tsan",       "configurePreset": "clang-tsan",       "output": { "outputOnFailure": true } },
        { "name": "cl-debug",         "configurePreset": "cl-debug",         "output": { "outputOnFailure": true } },
        { "name": "cl-release",       "configurePreset": "cl-release",       "output": { "outputOnFailure": true } },
        { "name": "clangcl-debug",    "configurePreset": "clangcl-debug",    "output": { "outputOnFailure": true } },
        { "name": "clangcl-release",  "configurePreset": "clangcl-release",  "output": { "outputOnFailure": true } },

        {
            "name": "cross-cl-release",
            "configurePreset": "cross-cl-release",
            "output": { "outputOnFailure": true },
            "environment": {
                "WINEPATH": "$env{QT_ROOT_DIR}/bin",
                "QT_QPA_PLATFORM": "offscreen"
            }
        },
        {
            "name": "cross-clangcl-release",
            "configurePreset": "cross-clangcl-release",
            "output": { "outputOnFailure": true },
            "environment": {
                "WINEPATH": "$env{QT_ROOT_DIR}/bin",
                "QT_QPA_PLATFORM": "offscreen"
            }
        }
    ]
}
